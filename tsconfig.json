{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@engine": [
        "./src/engine"
      ],
      "@art": [
        "./src/ui/art"
      ],
      "@sounds": [
        "./src/ui/sounds"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
