{
  "name": "color-catch-rooms",
  "version": "0.1.0",
  "private": true,
  "description": "Room server for Color Catch online games (PLAN-web-online.md Part B)",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "dev": "tsx src/main.ts",
    "test": "tsx --test \"src/**/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.cloudflare.json",
    "cf:dev": "wrangler dev --port 8787",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "wrangler": "4.149.0",
    "ws": "^8.22.0"
  }
}
