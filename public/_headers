# Cloudflare Pages response headers (copied into the export from public/).
# Bundles and assets carry a content hash in their names: cache them for good.
# The page itself is checked on every visit, so a new deploy shows at once.

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
